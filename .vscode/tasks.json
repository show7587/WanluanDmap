{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build backend",
            "type": "process",
            "command": "dotnet",
            "args": ["build", "${workspaceFolder}/backend/WanluanDmapApi.csproj"],
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "run backend",
            "type": "process",
            "command": "dotnet",
            "args": ["run", "--project", "${workspaceFolder}/backend"],
            "problemMatcher": "$msCompile",
            "isBackground": true
        },
        {
            "label": "frontend: npm install",
            "type": "npm",
            "script": "install",
            "path": "frontend",
            "problemMatcher": []
        },
        {
            "label": "frontend: dev",
            "type": "npm",
            "script": "dev",
            "path": "frontend",
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "frontend: build",
            "type": "npm",
            "script": "build",
            "path": "frontend",
            "group": "build",
            "problemMatcher": []
        }
    ]
}
